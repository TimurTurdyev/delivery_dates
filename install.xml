  <file path="catalog/view/theme/*/template/product/product.tpl">
    <operation error="skip">
      <search><![CDATA[<div id="product">]]></search>
      <add position="before"><![CDATA[<?php echo $delivery_dates; ?>]]></add>
    </operation>
  </file>
</modification>
